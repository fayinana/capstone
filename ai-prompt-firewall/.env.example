# Downstream LLM (OpenAI-compatible). Leave empty to use the local mock (no egress).
TARGET_BASE_URL=
TARGET_API_KEY=

# Proxy
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=firewall
POSTGRES_USER=firewall
POSTGRES_PASSWORD=change-me-db

# Dashboard
ADMIN_USERNAME=analyst
ADMIN_PASSWORD=change-me
DASHBOARD_PORT=8501

# Optional: forwarded application identity header (default X-Application-Id)
APPLICATION_ID_HEADER=X-Application-Id
